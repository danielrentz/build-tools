{
  "name": "@daniel.rentz/build-tools",
  "version": "0.0.4",
  "description": "Development helpers and shared configuration for other repositories.",
  "homepage": "https://github.com/danielrentz/build-tools#readme",
  "bugs": {
    "url": "https://github.com/danielrentz/build-tools/issues"
  },
  "license": "MIT",
  "author": "Daniel Rentz <daniel.rentz@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielrentz/build-tools.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.22.0",
  "files": [
    "CHANGELOG.md",
    "dist/"
  ],
  "exports": {
    "./oxfmt": "./dist/oxfmt/index.mjs",
    "./oxlint": "./dist/oxlint/index.mjs",
    "./tsdown": "./dist/tsdown/index.mjs",
    "./package.json": "./package.json",
    "./tsconfig.json": "./dist/tsconfig/tsconfig.json"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "prepack": "pnpm build",
    "test": "vitest run",
    "verify": "pnpm audit && pnpm peers check && pnpm build && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.0"
  }
}
